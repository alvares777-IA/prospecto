# Copie para .env (git-ignored) ao rodar fora do Docker.
# Dentro do container, estes valores vêm do docker-compose.yml (bloco `environment`).

# Porta do servidor Express
PORT=3004

# Postgres do stack PROSPECTO-IA — banco dedicado `jogodavida`.
# No host (npm run dev):   host=localhost porta=5433
# Dentro do compose:       host=postgres  porta=5432
DATABASE_URL=postgresql://prospecto:SENHA@localhost:5433/jogodavida

# Sessão HTTP das contas com login (gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JV_SESSION_SECRET=troque-isto

# Base pública, usada no callback do Google OAuth
JV_APP_URL=http://localhost:3004

# Login com Google (opcional). Só funciona se, além destas chaves, a
# redirect URI  <JV_APP_URL>/auth/google/callback  estiver liberada no
# Google Cloud Console. Sem isso, "entrar sem conta" e "e-mail + senha"
# continuam funcionando.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
