# Copie para .env (git-ignored) ao rodar fora do Docker.
# Dentro do container, estes valores vêm do docker-compose.yml (bloco `environment`).

# Porta do servidor Express
PORT=3004

# Postgres do stack PROSPECTO-IA — banco dedicado `jogodavida`.
# No host (npm run dev):   host=localhost porta=5433
# Dentro do compose:       host=postgres  porta=5432
DATABASE_URL=postgresql://prospecto:SENHA@localhost:5433/jogodavida
