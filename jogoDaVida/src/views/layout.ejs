<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Jogo da Vida' %> — Jogo da Vida</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body { background: #0b1020; color: #e2e8f0; }
    .navbar { background: #0d1224; border-bottom: 1px solid #1e2a45; }
    .navbar-brand { font-weight: 800; letter-spacing: 0.5px;
      background: linear-gradient(90deg, #00f0ff, #8b5cf6);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    a { color: #38bdf8; }
  </style>
</head>
<body>
  <nav class="navbar px-3">
    <a class="navbar-brand" href="/jogo"><i class="bi bi-grid-3x3-gap-fill me-2"></i>Jogo da Vida</a>
    <div class="d-flex align-items-center gap-3">
      <span class="text-secondary small">
        <i class="bi bi-person-circle me-1"></i><%= usuario.nome %> (<%= usuario.perfil %>)
      </span>
      <form method="post" action="/sair" class="m-0">
        <button type="submit" class="btn btn-sm btn-outline-light">
          <i class="bi bi-box-arrow-right me-1"></i>Sair
        </button>
      </form>
    </div>
  </nav>

  <main class="container py-4">
    <% if (flash && flash.sucesso) { %>
    <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i><%= flash.sucesso %></div>
    <% } %>
    <% if (flash && flash.erro) { %>
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i><%= flash.erro %></div>
    <% } %>

    <%- body %>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
